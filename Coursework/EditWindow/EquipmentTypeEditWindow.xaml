<Window x:Class="Coursework.Views.EquipmentTypeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование типа техники" Height="300" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Название:"/>
            <TextBox x:Name="tbName" Height="35" Margin="0 5 0 15"/>

            <TextBlock Text="Категория:"/>
            <TextBox x:Name="tbCategory" Height="35" Margin="0 5 0 15"/>

            <Button Content="Сохранить" Height="40" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>