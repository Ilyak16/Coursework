<Window x:Class="Coursework.Views.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали заказа" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Информация о заказе -->
        <Border Grid.Row="0" Background="White" Padding="15" CornerRadius="5" Margin="0 0 0 10">
            <StackPanel>
                <TextBlock x:Name="tbOrderId" FontWeight="Bold" FontSize="16"/>
                <TextBlock x:Name="tbClientInfo" Margin="0 5 0 0"/>
                <TextBlock x:Name="tbDate" Margin="0 5 0 0"/>
                <TextBlock x:Name="tbStatus" Margin="0 5 0 0"/>
                <TextBlock x:Name="tbTotalPrice" FontWeight="Bold" Foreground="#2E7D32" Margin="0 10 0 0"/>
            </StackPanel>
        </Border>

        <!-- Таблица позиций -->
        <TextBlock Grid.Row="1" Text="Позиции заказа:" FontWeight="Bold" Margin="0 0 0 5"/>
        <DataGrid x:Name="dgItems" Grid.Row="2" AutoGenerateColumns="False" 
                  IsReadOnly="True" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding НазваниеТовара}" Width="*"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Количество}" Width="100"/>
                <DataGridTextColumn Header="Цена за ед." Binding="{Binding Стоимость, StringFormat={}{0:F2}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>