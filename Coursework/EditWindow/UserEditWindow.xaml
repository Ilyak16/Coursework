<Window x:Class="Coursework.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование пользователя" Height="450" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="ФИО:"/>
            <TextBox x:Name="tbFio" Height="35" Margin="0 5 0 15"/>

            <TextBlock Text="Логин:"/>
            <TextBox x:Name="tbLogin" Height="35" Margin="0 5 0 15"/>

            <TextBlock Text="Пароль (оставьте пустым, чтобы не менять):"/>
            <PasswordBox x:Name="pbPassword" Height="35" Margin="0 5 0 15"/>

            <TextBlock Text="Роль:"/>
            <ComboBox x:Name="cbRole" Height="35" Margin="0 5 0 15">
                <ComboBoxItem Content="Client"/>
                <ComboBoxItem Content="Manager"/>
                <ComboBoxItem Content="Admin"/>
            </ComboBox>

            <Button Content="Сохранить" Height="40" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>