<Window x:Class="Coursework.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Администратор"
        Height="700"
        Width="1200">

    <Grid Margin="10">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <ComboBox x:Name="TablesBox"
                  Height="35"
                  SelectionChanged=
                  "TablesBox_SelectionChanged"/>

        <DataGrid x:Name="AdminGrid" 
                  Grid.Row="1" 
                  Margin="0 10" 
                  AutoGenerateColumns="True" 
                  IsReadOnly="False" 
                  CanUserAddRows="True" 
                  CanUserDeleteRows="True"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- Кнопка видна ТОЛЬКО для таблицы Заказ -->
            <Button x:Name="btnOrderDetails" 
            Content="Детали заказа" 
            Width="150" 
            Click="ViewOrderDetails_Click"
            Visibility="Collapsed"
            Margin="0 0 10 0"/>

            <Button Content="Редактировать / Добавить" Width="180" Click="Edit_Click"/>
            <Button Content="Удалить" Width="120" Click="Delete_Click"/>
        </StackPanel>

    </Grid>
</Window>