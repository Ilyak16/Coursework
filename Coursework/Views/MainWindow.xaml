<Window x:Class="Coursework.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог товаров"
        Height="600"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="10">

        <Border DockPanel.Dock="Top"
                Background="White"
                Padding="10"
                CornerRadius="10"
                Margin="0 0 0 10">

            <StackPanel Orientation="Horizontal">

                <TextBox x:Name="tbSearch"
                         Width="250"
                         Height="35"
                         Margin="5"
                         VerticalContentAlignment="Center"
                         TextChanged="Search_TextChanged"/>

                <Button x:Name="btnAdd"
                        Content="Добавить"
                        Width="120"
                        Click="Add_Click"/>

                <Button x:Name="btnDelete"
                        Content="Удалить"
                        Width="120"
                        Click="Delete_Click"/>

                <Button Content="Админ панель"
                        Width="140"
                        Click="Admin_Click"
                        x:Name="btnAdmin"/>

                <!-- Кнопка просмотра корзины -->
                <Button Content="Корзина"
                        Width="120"
                        Click="Cart_Click"/>

                <Button Content="В корзину"
                        Width="120"
                        Click="AddToCart_Click"/>

                <Button Content="Оформить заказ"
                        Width="140"
                        Click="Checkout_Click"/>

                <Button Content="Выход"
                        Width="120"
                        Click="Logout_Click"/>

                <TextBlock x:Name="tbCartCount" 
                           Text="Корзина: 0" 
                           Margin="20 0 0 0" 
                           VerticalAlignment="Center" 
                           FontWeight="Bold" 
                           Foreground="#2E7D32"/>

                <TextBlock x:Name="tbUser"
                           Margin="20 0 0 0"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           FontSize="16"/>
            </StackPanel>

        </Border>

        <DataGrid x:Name="dgProducts"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  Background="White"/>

    </DockPanel>
</Window>