<Window x:Class="Coursework.Views.CategoryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование категории" Height="250" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Название категории:"/>
            <TextBox x:Name="tbName" Height="35" Margin="0 5 0 15"/>
            <Button Content="Сохранить" Height="40" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>