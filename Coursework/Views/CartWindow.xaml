<Window x:Class="Coursework.Views.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Корзина" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<DataGrid x:Name="dgCart" AutoGenerateColumns="False"
                  IsReadOnly="True" Background="White" Margin="0 0 0 10">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Товар" Binding="{Binding Название}" Width="*"/>
				<DataGridTextColumn Header="Цена" Binding="{Binding Цена, StringFormat={}{0:F2}}" Width="100"/>
				<DataGridTextColumn Header="Количество" Binding="{Binding Количество}" Width="100"/>
				<DataGridTextColumn Header="Сумма" Binding="{Binding Сумма, StringFormat={}{0:F2}}" Width="100"/>
			</DataGrid.Columns>
		</DataGrid>

		<Border Grid.Row="1" Background="White" Padding="15" CornerRadius="5" Margin="0 0 0 10">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<TextBlock Text="Итого: " FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
				<TextBlock x:Name="tbTotal" Text="0.00 ₽" FontSize="20"
                           FontWeight="Bold" Foreground="#2E7D32" Margin="10 0 0 0"/>
			</StackPanel>
		</Border>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button Content="Продолжить покупки" Width="180" Click="Continue_Click"/>
			<Button Content="Оформить заказ" Width="180" Click="Checkout_Click"
                    Background="#2E7D32" Foreground="White" FontWeight="Bold"/>
		</StackPanel>
	</Grid>
</Window>