<Window x:Class="Coursework.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация"
        Height="650"
        Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Border Width="400"
                Height="560"
                Background="White"
                CornerRadius="10"
                Padding="20">

            <StackPanel>

                <TextBlock Text="Регистрация"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="0 0 0 20"/>

                <TextBlock Text="ФИО"/>

                <TextBox x:Name="FullNameBox"
                         Height="35"/>

                <TextBlock Text="Логин"
                           Margin="0 10 0 0"/>

                <TextBox x:Name="LoginBox"
                         Height="35"/>

                <TextBlock Text="Пароль"
                           Margin="0 10 0 0"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="35"/>

                <TextBlock Text="Подтвердите пароль"
                           Margin="0 10 0 0"/>

                <PasswordBox x:Name="RepeatPasswordBox"
                             Height="35"/>

                <Button Content="Зарегистрироваться"
                        Margin="0 20 0 0"
                        Click="Register_Click"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>