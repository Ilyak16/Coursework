<Window x:Class="Coursework.Views.ResourceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование ресурса" Height="400" Width="450"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Название:"/>
            <TextBox x:Name="tbName" Height="35" Margin="0 5 0 15"/>

            <TextBlock Text="Тип ресурса:"/>
            <TextBox x:Name="tbType" Height="35" Margin="0 5 0 15"/>

            <TextBlock Text="Система счисления:"/>
            <TextBox x:Name="tbUnit" Height="35" Margin="0 5 0 15"/>

            <Button Content="Сохранить" Height="40" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>