<Window x:Class="Coursework.Views.WorkTypeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование типа работ" Height="350" Width="450"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Название:"/>
            <TextBox x:Name="tbName" Height="35" Margin="0 5 0 15"/>

            <TextBlock Text="Описание:"/>
            <TextBox x:Name="tbDescription" Height="80" Margin="0 5 0 15" 
                     TextWrapping="Wrap" AcceptsReturn="True"/>

            <Button Content="Сохранить" Height="40" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>